{
  "name": "@logbrew/browser",
  "version": "0.1.10",
  "description": "Browser error, page-view, action, network, and fetch transport helpers for the public LogBrew JavaScript SDK.",
  "type": "module",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      },
      "default": "./index.js"
    }
  },
  "files": [
    "beacon-transport.cjs",
    "beacon-transport.js",
    "fetch-spans.cjs",
    "fetch-spans.js",
    "interaction-timing.cjs",
    "interaction-timing.js",
    "index.cjs",
    "index.js",
    "lifecycle-delivery.cjs",
    "lifecycle-delivery.js",
    "lifecycle-transport.cjs",
    "lifecycle-transport.js",
    "navigation-timing.cjs",
    "navigation-timing.js",
    "persistence.cjs",
    "persistence.js",
    "resource-timing.cjs",
    "resource-timing.js",
    "runtime-context.cjs",
    "runtime-context.js",
    "trace-context.cjs",
    "trace-context.js",
    "web-vitals.cjs",
    "web-vitals.js",
    "xhr-spans.cjs",
    "xhr-spans.js",
    "index.d.ts",
    "index.d.cts",
    "README.md",
    "examples"
  ],
  "keywords": [
    "logbrew",
    "browser",
    "frontend",
    "observability",
    "errors",
    "logs",
    "traces",
    "events"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LogBrewCo/sdk.git"
  },
  "peerDependencies": {
    "@logbrew/sdk": "^0.1.7"
  },
  "scripts": {
    "test": "bun test"
  }
}
