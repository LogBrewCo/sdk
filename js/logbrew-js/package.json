{
  "name": "@logbrew/sdk",
  "version": "0.1.38",
  "description": "Public LogBrew JavaScript SDK for building, validating, and flushing event batches.",
  "type": "module",
  "main": "./index.cjs",
  "react-native": "./react-native.js",
  "types": "./index.d.ts",
  "bin": {
    "logbrew-release-artifacts": "./release-artifacts.js"
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./react-native.d.ts",
        "default": "./react-native.js"
      },
      "browser": {
        "types": "./react-native.d.ts",
        "default": "./react-native.js"
      },
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      },
      "default": "./index.js"
    },
    "./vite-release-artifacts": {
      "import": {
        "types": "./vite-release-artifacts.d.ts",
        "default": "./vite-release-artifacts.js"
      },
      "require": {
        "types": "./vite-release-artifacts.d.cts",
        "default": "./vite-release-artifacts.cjs"
      },
      "default": "./vite-release-artifacts.js"
    }
  },
  "files": [
    "index.cjs",
    "browser-breadcrumbs.cjs",
    "core.cjs",
    "capture-support.cjs",
    "client.cjs",
    "automatic-delivery.cjs",
    "batch-sender.cjs",
    "bounded-number.cjs",
    "client-options.cjs",
    "client-report.cjs",
    "delivery-health.cjs",
    "event-pipeline.cjs",
    "event-queue.cjs",
    "event-store.cjs",
    "provided-breadcrumbs.cjs",
    "random-hex.cjs",
