{
  "name": "@logbrew/sdk",
  "version": "0.1.15",
  "description": "Public LogBrew JavaScript SDK for building, validating, and flushing event batches.",
  "type": "module",
  "main": "./index.cjs",
  "react-native": "./react-native.js",
  "types": "./index.d.ts",
  "bin": {
    "logbrew-release-artifacts": "./release-artifacts.js"
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./react-native.d.ts",
        "default": "./react-native.js"
      },
      "browser": {
        "types": "./react-native.d.ts",
        "default": "./react-native.js"
      },
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      },
      "default": "./index.js"
    },
    "./vite-release-artifacts": {
      "import": {
        "types": "./vite-release-artifacts.d.ts",
        "default": "./vite-release-artifacts.js"
      },
      "require": {
        "types": "./vite-release-artifacts.d.cts",
        "default": "./vite-release-artifacts.cjs"
      },
      "default": "./vite-release-artifacts.js"
    }
  },
  "files": [
    "index.cjs",
    "core.cjs",
    "index.js",
    "index.d.ts",
    "index.d.cts",
    "issue-diagnostics.cjs",
    "issue-stack.cjs",
    "log-context.cjs",
    "opentelemetry.cjs",
    "react-native.js",
    "react-native.d.ts",
    "support-ticket.cjs",
    "telemetry-context.cjs",
    "trace-context.cjs",
    "winston.cjs",
    "release-artifacts-common.js",
    "release-artifacts-build.cjs",
    "release-artifacts.js",
    "release-artifacts-upload.js",
    "release-artifacts-symbolication.js",
    "vite-release-artifacts.cjs",
    "vite-release-artifacts.js",
    "vite-release-artifacts.d.ts",
    "vite-release-artifacts.d.cts",
    "README.md",
    "examples"
  ],
  "keywords": [
    "logbrew",
    "observability",
    "logs",
    "traces",
    "events"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LogBrewCo/sdk.git"
  },
  "scripts": {
    "test": "bun test",
    "smoke": "bun ./smoke.js"
  }
}
