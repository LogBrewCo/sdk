    "typescript/require-await": "off",
    "unicorn/no-useless-undefined": "off",
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "ignoreRestSiblings": true,
        "varsIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "logbrew-js/null-value.cjs",
        "logbrew-react-native/null-value.cjs"
      ],
      "rules": {
        "unicorn/no-null": "off"
      }
    },
    {
      "files": [
        "logbrew-js/winston.cjs"
      ],
      "rules": {
        "import/no-nodejs-modules": "off",
        "promise/prefer-await-to-callbacks": "off"
      }
    },
    {
      "files": [
        "logbrew-*/*.cjs",
        "logbrew-express/test/*.cjs",
        "logbrew-vue/test/*.cjs",
        "logbrew-js/examples/*.cjs"
      ],
      "rules": {
        "import/no-commonjs": "off",
        "import/unambiguous": "off",
        "typescript/no-require-imports": "off",
        "typescript/no-var-requires": "off"
      }
    },
    {
      "files": [
        "logbrew-*/index.cjs",
        "logbrew-*/index.d.cts",
        "logbrew-*/index.d.ts",
        "logbrew-*/index.js",
