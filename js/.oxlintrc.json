{
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "jsdoc",
    "promise",
    "node",
    "vue"
  ],
  "categories": {
    "correctness": "error",
    "nursery": "error",
    "pedantic": "error",
    "perf": "error",
    "restriction": "error",
    "style": "error",
    "suspicious": "error"
  },
  "env": {
    "builtin": true,
    "es2022": true,
    "node": true
  },
  "rules": {
    "eslint/func-style": [
      "error",
      "declaration"
    ],
    "eslint/max-lines": [
      "error",
      {
        "skipBlankLines": false,
        "skipComments": true
      }
    ],
    "eslint/no-redeclare": [
      "error",
      {
        "builtinGlobals": false
      }
    ],
    "eslint/no-ternary": "off",
    "eslint/no-undefined": "off",
    "eslint/no-void": [
      "error",
      {
        "allowAsStatement": true
      }
    ],
    "eslint/one-var": [
      "error",
      "never"
    ],
    "eslint/require-await": "off",
    "eslint/sort-keys": [
      "error",
      "asc",
      {
        "allowLineSeparatedGroups": true
      }
    ],
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "jsdoc/require-param-description": "off",
    "jsdoc/require-property-description": "off",
    "jsdoc/require-returns-description": "off",
    "node/no-top-level-await": "off",
    "oxc/no-async-await": "off",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "typescript/consistent-type-definitions": [
      "error",
      "type"
    ],
    "typescript/no-misused-spread": [
      "error",
      {
        "allow": [
          {
            "from": "lib",
            "name": "string"
          }
        ]
      }
    ],
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "name": [
              "Buffer",
              "NonSharedBuffer"
            ],
            "package": "@types/node"
          },
          {
            "from": "package",
            "name": "ConsumeMessage",
            "package": "amqplib"
          },
          {
            "from": "package",
            "name": [
              "EachBatchPayload",
              "EachMessagePayload",
              "ProducerBatch",
              "ProducerRecord",
              "TopicMessages"
            ],
            "package": "kafkajs"
          },
          {
            "from": "file",
            "name": "LogBrewAmqplibConsumeOptions"
          },
          {
            "from": "file",
            "name": "LogBrewAmqplibPublishOptions"
          },
          {
