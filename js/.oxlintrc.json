      "rules": {
        "eslint/class-methods-use-this": [
          "error",
          {
            "exceptMethods": [
              "auto",
              "fail",
              "logbrew"
            ]
          }
        ],
        "eslint/max-classes-per-file": [
          "error",
          4
        ],
        "eslint/new-cap": [
          "error",
          {
            "capIsNewExceptions": [
              "Controller",
              "Get",
              "Module",
              "Req"
            ]
          }
