{
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "jsdoc",
    "promise",
    "node",
    "vue"
  ],
  "categories": {
    "correctness": "error",
    "nursery": "error",
    "pedantic": "error",
    "perf": "error",
    "restriction": "error",
    "style": "error",
    "suspicious": "error"
  },
  "env": {
    "builtin": true,
    "es2022": true,
    "node": true
  },
  "rules": {
    "eslint/func-style": [
      "error",
      "declaration"
    ],
    "eslint/max-lines": [
      "error",
      {
        "skipBlankLines": false,
        "skipComments": true
      }
    ],
    "eslint/no-redeclare": [
      "error",
      {
        "builtinGlobals": false
      }
    ],
    "eslint/no-ternary": "off",
    "eslint/no-undefined": "off",
    "eslint/no-void": [
      "error",
      {
        "allowAsStatement": true
      }
    ],
    "eslint/one-var": [
      "error",
      "never"
    ],
    "eslint/require-await": "off",
    "eslint/sort-keys": [
      "error",
      "asc",
      {
        "allowLineSeparatedGroups": true
      }
    ],
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "jsdoc/require-param-description": "off",
    "jsdoc/require-property-description": "off",
    "jsdoc/require-returns-description": "off",
    "node/no-top-level-await": "off",
    "oxc/no-async-await": "off",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "typescript/consistent-type-definitions": [
      "error",
      "type"
    ],
    "typescript/no-misused-spread": [
      "error",
      {
        "allow": [
          {
            "from": "lib",
            "name": "string"
          }
        ]
      }
    ],
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "name": [
              "Buffer",
              "NonSharedBuffer"
            ],
            "package": "@types/node"
          },
          {
            "from": "package",
            "name": "ConsumeMessage",
            "package": "amqplib"
          },
          {
            "from": "package",
            "name": [
              "EachBatchPayload",
              "EachMessagePayload",
              "ProducerBatch",
              "ProducerRecord",
              "TopicMessages"
            ],
            "package": "kafkajs"
          },
          {
            "from": "file",
            "name": "LogBrewAmqplibConsumeOptions"
          },
          {
            "from": "file",
            "name": "LogBrewAmqplibPublishOptions"
          },
          {
            "from": "file",
            "name": "LogBrewKafkaJsBatchProcessOptions"
          },
          {
            "from": "file",
            "name": "LogBrewKafkaJsInstrumentationOptions"
          },
          {
            "from": "file",
            "name": "LogBrewKafkaJsProcessOptions"
          },
          {
            "from": "file",
            "name": "LogBrewKafkaJsSendOptions"
          },
          {
            "from": "package",
            "name": "PackageJson",
            "package": "@npm/types"
          },
          {
            "from": "package",
            "name": [
              "IncomingMessage",
              "ServerResponse"
            ],
            "package": "@types/node"
          },
          {
            "from": "lib",
            "name": [
              "MessageEvent",
              "Response"
            ]
          },
          {
            "from": "file",
            "name": "LogBrewPrismaExtensionOptions"
          },
          {
            "from": "file",
            "name": "LogBrewPrismaSpanOptions"
          },
          {
            "from": "package",
            "name": [
              "FastifyInstance",
              "FastifyReply",
              "FastifyRequest"
            ],
            "package": "fastify"
          },
          {
            "from": "file",
            "name": [
              "LogBrewClient",
              "RecordingTransport",
              "SpanLinkSummary",
              "Transport"
            ],
            "path": "../logbrew-js/index.d.ts"
          },
          {
            "from": "file",
            "name": [
              "CreateLogBrewFastifyClientConfig",
              "LogBrewFastifyOptions"
            ]
          },
          {
            "from": "package",
            "name": "FastifyError",
            "package": "@fastify/error"
          },
          {
            "from": "package",
            "name": [
              "Message",
              "SendMessageBatchCommandInput",
              "SendMessageCommandInput",
              "ReceiveMessageCommandInput"
            ],
            "package": "@aws-sdk/client-sqs"
          },
          {
            "from": "file",
            "name": [
              "LogBrewEventBridgeOperationOptions",
              "LogBrewSnsBatchOperationOptions",
              "LogBrewSnsOperationOptions",
              "LogBrewSqsBatchOperationOptions",
              "LogBrewSqsInstrumentableClient",
              "LogBrewSqsOperationOptions"
            ]
          },
          {
            "from": "package",
            "name": [
              "FlowJob",
              "FlowOpts",
              "Job"
            ],
            "package": "bullmq"
          },
          {
            "from": "file",
            "name": [
              "LogBrewBullMqBulkJob",
              "LogBrewBullMqJobOptions",
              "LogBrewBullMqSpanOptions"
            ]
          },
          {
            "from": "file",
            "name": [
              "LogBrewTraceContext"
            ],
            "path": "../logbrew-node/index.d.ts"
          },
          {
            "from": "package",
            "name": "AbortSignal",
            "package": "@types/node"
          },
          {
            "from": "package",
            "name": [
              "CallHandler",
              "ExecutionContext"
            ],
            "package": "@nestjs/common"
          },
          {
            "from": "package",
            "name": [
              "NextFunction",
              "Request",
              "Response"
            ],
            "package": "express"
          },
          {
            "from": "file",
            "name": [
              "CreateLogBrewNestClientConfig",
              "LogBrewNestLoggerOptions",
              "LogBrewNestOptions"
            ]
          },
          {
            "from": "package",
            "name": "Subscriber",
            "package": "rxjs"
          },
          {
            "from": "file",
            "name": [
              "CreateLogBrewExpressClientConfig",
              "LogBrewExpressErrorHandlerOptions",
              "LogBrewExpressOptions",
              "LogBrewExpressSharedOptions"
            ]
          },
          {
            "from": "package",
            "name": "TestContext",
            "package": "@types/node"
          },
          {
            "from": "lib",
            "name": [
              "RegExp",
              "Request",
              "RequestInit",
              "URL"
            ]
          },
          {
            "from": "package",
            "name": [
              "ErrorHandler",
              "Injector"
            ],
            "package": "@angular/core"
          },
          {
            "from": "package",
            "name": [
              "App",
              "ComponentPublicInstance"
            ],
            "package": "@vue/runtime-core"
          },
          {
            "from": "file",
            "name": [
              "CreateLogBrewVueClientConfig",
              "LogBrewVueContext",
              "LogBrewVueErrorContext",
              "LogBrewVueErrorEventOptions",
              "LogBrewVueOptions",
              "LogBrewVueRuntimeContext",
              "LogBrewVueViewEventOptions",
              "VueTraceparentConfig"
            ]
          },
          {
            "from": "file",
            "name": [
              "AngularTraceparentConfig",
              "CreateLogBrewAngularClientConfig",
              "LogBrewAngularCaptureContext",
              "LogBrewAngularContext",
              "LogBrewAngularErrorEventOptions",
              "LogBrewAngularErrorMetadata",
              "LogBrewAngularOptions",
              "LogBrewAngularRuntimeContext",
              "LogBrewAngularViewEventOptions",
              "TraceparentFetchConfig",
              "TraceparentRequestContext"
            ]
          },
          {
            "from": "file",
            "name": [
              "BrowserTraceparentConfig",
              "CreateLogBrewSvelteClientConfig",
              "LogBrewSvelteCaptureOptions",
              "LogBrewSvelteContext",
              "LogBrewSvelteErrorOptions",
              "LogBrewSvelteKitHooksOptions",
              "LogBrewSvelteOptions"
            ]
          }
        ]
      }
    ],
    "typescript/require-await": "off",
    "unicorn/no-useless-undefined": "off",
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "ignoreRestSiblings": true,
        "varsIgnorePattern": "^_"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "logbrew-js/null-value.cjs"
      ],
      "rules": {
        "unicorn/no-null": "off"
      }
    },
    {
      "files": [
        "logbrew-js/winston.cjs"
      ],
      "rules": {
        "import/no-nodejs-modules": "off",
        "promise/prefer-await-to-callbacks": "off"
      }
    },
    {
      "files": [
        "logbrew-*/*.cjs",
        "logbrew-express/test/*.cjs",
        "logbrew-vue/test/*.cjs"
      ],
      "rules": {
        "import/no-commonjs": "off",
        "import/unambiguous": "off",
        "typescript/no-require-imports": "off",
        "typescript/no-var-requires": "off"
      }
    },
    {
      "files": [
        "logbrew-*/index.cjs",
        "logbrew-*/index.d.cts",
        "logbrew-*/index.d.ts",
        "logbrew-*/index.js",
        "logbrew-js/vite-release-artifacts.d.cts",
        "logbrew-js/vite-release-artifacts.d.ts",
        "logbrew-js/vite-release-artifacts.js"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": [
        "logbrew-amqplib/index.cjs",
        "logbrew-amqplib/index.d.ts",
        "logbrew-amqplib/index.js"
      ],
      "rules": {
        "eslint/max-params": [
          "error",
          {
            "max": 6
          }
        ]
      }
    },
    {
      "files": [
        "logbrew-*/examples/index.mjs",
        "logbrew-*/examples/readme-example.mjs"
      ],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "logbrew-amqplib/**",
        "logbrew-kafkajs/**",
        "logbrew-fastify/**",
        "logbrew-nestjs/**",
        "logbrew-express/**",
        "logbrew-js/release-artifacts*",
        "logbrew-js/test/release-artifacts*",
        "logbrew-js/vite-release-artifacts*.cjs",
        "logbrew-angular/examples/**",
        "logbrew-svelte/examples/**",
        "logbrew-vue/examples/**",
        "logbrew-vue/test/**"
      ],
      "rules": {
        "import/no-nodejs-modules": "off"
      }
    },
    {
      "files": [
        "logbrew-js/release-artifacts-build.cjs",
        "logbrew-js/vite-release-artifacts-config.cjs"
      ],
      "rules": {
        "node/no-sync": "off"
      }
    },
    {
      "files": [
        "logbrew-js/release-artifacts-manifest-artifact.js",
        "logbrew-js/test/release-artifacts-vite.test.js",
        "logbrew-js/vite-release-artifacts-config.cjs"
      ],
      "rules": {
        "unicorn/no-null": "off"
      }
    },
    {
      "files": [
        "logbrew-js/release-artifacts-upload.js"
      ],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "**/tools/npm-publish/**"
      ],
      "rules": {
        "eslint/no-await-in-loop": "off",
        "import/no-nodejs-modules": "off",
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "**/benchmarks/*.mjs",
        "**/benchmarks/overhead/*.mjs"
      ],
      "rules": {
        "import/no-nodejs-modules": "off"
      }
    },
    {
      "files": [
        "**/benchmarks/**"
      ],
      "rules": {
        "eslint/no-await-in-loop": "off"
      }
    },
    {
      "files": [
        "**/benchmarks/latency.mjs",
        "**/benchmarks/overhead/cdp.mjs"
      ],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "**/benchmarks/size/**"
      ],
      "rules": {
        "eslint/require-unicode-regexp": "off",
        "eslint/sort-imports": "off",
        "import/no-namespace": "off"
      }
    },
    {
      "files": [
        "logbrew-fastify/internal.cjs",
        "logbrew-nestjs/internal.cjs",
        "logbrew-express/internal.cjs"
      ],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "logbrew-fastify/index.d.ts",
        "logbrew-nestjs/index.d.ts",
        "logbrew-express/index.d.ts",
        "logbrew-vue/index.d.cts",
        "logbrew-vue/index.d.ts"
      ],
      "rules": {
        "typescript/consistent-type-definitions": "off"
      }
    },
    {
      "files": [
        "logbrew-vue/examples/real-user-smoke.mjs",
        "logbrew-vue/test/error-handler-ownership.test.mjs"
      ],
      "rules": {
        "unicorn/no-null": "off"
      }
    },
    {
      "files": [
        "logbrew-vue/index.cjs",
        "logbrew-vue/index.js"
      ],
      "rules": {
        "typescript/no-confusing-void-expression": [
          "error",
          {
            "ignoreVoidReturningFunctions": true
          }
        ]
      }
    },
    {
      "files": [
        "logbrew-fastify/examples/*.mjs"
      ],
      "rules": {
        "oxc/no-async-endpoint-handlers": "off"
      }
    },
    {
      "files": [
        "logbrew-aws-sqs/index.cjs",
        "logbrew-aws-sqs/index.d.ts",
        "logbrew-nestjs/index.d.ts",
        "logbrew-nestjs/logger.cjs",
        "logbrew-express/index.cjs",
        "logbrew-express/index.d.ts",
        "logbrew-express/examples/real-user-smoke.mjs",
        "logbrew-express/test/support.js"
      ],
      "rules": {
        "eslint/max-params": [
          "error",
          {
            "max": 4
          }
        ]
      }
    },
    {
      "files": [
        "logbrew-bullmq/index.cjs",
        "logbrew-bullmq/index.d.cts",
        "logbrew-bullmq/index.d.ts",
        "logbrew-vue/index.cjs",
        "logbrew-vue/index.d.cts",
        "logbrew-vue/index.d.ts",
        "logbrew-vue/index.js"
      ],
      "rules": {
        "eslint/max-params": [
          "error",
          {
            "max": 5
          }
        ]
      }
    },
    {
      "files": [
        "logbrew-bullmq/index.d.cts",
        "logbrew-bullmq/index.d.ts"
      ],
      "rules": {
        "typescript/no-unnecessary-type-parameters": "off"
      }
    },
    {
      "files": [
        "logbrew-nestjs/logger.cjs"
      ],
      "rules": {
        "unicorn/no-null": "off"
      }
    },
    {
      "files": [
        "logbrew-nestjs/examples/*.mjs"
      ],
      "rules": {
        "eslint/class-methods-use-this": [
          "error",
          {
            "exceptMethods": [
              "auto",
              "fail",
              "logbrew"
            ]
          }
        ],
        "eslint/max-classes-per-file": [
          "error",
          4
        ],
        "eslint/new-cap": [
          "error",
          {
            "capIsNewExceptions": [
              "Controller",
              "Get",
              "Module",
              "Req"
            ]
          }
        ],
        "import/no-unassigned-import": [
          "error",
          {
            "allow": [
              "reflect-metadata"
            ]
          }
        ],
        "typescript/no-extraneous-class": [
          "error",
          {
            "allowEmpty": true
          }
        ]
      }
    },
    {
      "files": [
        "logbrew-express/test/support.js"
      ],
      "rules": {
        "unicorn/no-thenable": "off"
      }
    },
    {
      "files": [
        "logbrew-express/test/error-middleware.test.js",
        "logbrew-express/test/handler-wrapper-unit.test.js"
      ],
      "rules": {
        "node/callback-return": "off",
        "promise/prefer-await-to-callbacks": "off"
      }
    },
    {
      "files": [
        "logbrew-express/test/mounted-app.js"
      ],
      "rules": {
        "eslint/new-cap": [
          "error",
          {
            "capIsNewExceptions": [
              "Router"
            ]
          }
        ]
      }
    }
  ]
}
