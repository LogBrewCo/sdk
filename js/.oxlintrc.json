{
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "jsdoc",
    "promise",
    "node"
  ],
  "categories": {
    "correctness": "error",
    "nursery": "error",
    "pedantic": "error",
    "perf": "error",
    "restriction": "error",
    "style": "error",
    "suspicious": "error"
  },
  "env": {
    "builtin": true,
    "es2022": true,
    "node": true
  },
  "rules": {
    "eslint/func-style": [
      "error",
      "declaration"
    ],
    "eslint/max-lines": [
      "error",
      {
        "skipBlankLines": false,
        "skipComments": true
      }
    ],
    "eslint/no-redeclare": [
      "error",
      {
        "builtinGlobals": false
      }
    ],
    "eslint/no-ternary": "off",
    "eslint/no-undefined": "off",
    "eslint/no-void": [
      "error",
      {
        "allowAsStatement": true
      }
    ],
    "eslint/one-var": [
      "error",
      "never"
    ],
    "eslint/require-await": "off",
    "eslint/sort-keys": [
      "error",
      "asc",
      {
        "allowLineSeparatedGroups": true
      }
    ],
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    "jsdoc/require-param-description": "off",
    "jsdoc/require-property-description": "off",
    "jsdoc/require-returns-description": "off",
    "node/no-top-level-await": "off",
    "oxc/no-async-await": "off",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "typescript/consistent-type-definitions": [
      "error",
      "type"
    ],
    "typescript/no-misused-spread": [
      "error",
      {
        "allow": [
          {
            "from": "lib",
            "name": "string"
          }
        ]
      }
    ],
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "allow": [
          {
            "from": "package",
            "name": "Buffer",
            "package": "@types/node"
          },
          {
            "from": "package",
            "name": "ConsumeMessage",
            "package": "amqplib"
          },
          {
            "from": "package",
            "name": [
              "EachBatchPayload",
              "EachMessagePayload",
              "ProducerBatch",
              "ProducerRecord",
              "TopicMessages"
            ],
            "package": "kafkajs"
          },
          {
            "from": "file",
            "name": "LogBrewAmqplibConsumeOptions"
          },
          {
            "from": "file",
            "name": "LogBrewAmqplibPublishOptions"
          },
          {
            "from": "file",
            "name": "LogBrewKafkaJsBatchProcessOptions"
          },
          {
            "from": "file",
            "name": "LogBrewKafkaJsInstrumentationOptions"
          },
          {
            "from": "file",
            "name": "LogBrewKafkaJsProcessOptions"
          },
          {
            "from": "file",
            "name": "LogBrewKafkaJsSendOptions"
          },
          {
            "from": "package",
            "name": "PackageJson",
            "package": "@npm/types"
          },
          {
            "from": "package",
            "name": [
              "IncomingMessage",
              "ServerResponse"
            ],
            "package": "@types/node"
          },
          {
            "from": "lib",
            "name": [
              "MessageEvent",
              "Response"
            ]
          }
        ]
      }
    ],
    "typescript/require-await": "off",
    "unicorn/no-useless-undefined": "off"
  },
  "overrides": [
    {
      "files": [
        "logbrew-*/*.cjs"
      ],
      "rules": {
        "import/no-commonjs": "off",
        "import/unambiguous": "off",
        "typescript/no-require-imports": "off",
        "typescript/no-var-requires": "off"
      }
    },
    {
      "files": [
        "logbrew-*/index.cjs",
        "logbrew-*/index.d.cts",
        "logbrew-*/index.d.ts",
        "logbrew-*/index.js"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": [
        "logbrew-amqplib/index.cjs",
        "logbrew-amqplib/index.d.ts",
        "logbrew-amqplib/index.js"
      ],
      "rules": {
        "eslint/max-params": [
          "error",
          {
            "max": 6
          }
        ]
      }
    },
    {
      "files": [
        "logbrew-*/examples/index.mjs",
        "logbrew-*/examples/readme-example.mjs"
      ],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "logbrew-amqplib/**",
        "logbrew-kafkajs/**"
      ],
      "rules": {
        "import/no-nodejs-modules": "off"
      }
    },
    {
      "files": [
        "**/tools/npm-publish/**"
      ],
      "rules": {
        "eslint/no-await-in-loop": "off",
        "import/no-nodejs-modules": "off",
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "**/benchmarks/*.mjs",
        "**/benchmarks/overhead/*.mjs"
      ],
      "rules": {
        "import/no-nodejs-modules": "off"
      }
    },
    {
      "files": [
        "**/benchmarks/**"
      ],
      "rules": {
        "eslint/no-await-in-loop": "off"
      }
    },
    {
      "files": [
        "**/benchmarks/latency.mjs",
        "**/benchmarks/overhead/cdp.mjs"
      ],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "**/benchmarks/size/**"
      ],
      "rules": {
        "eslint/require-unicode-regexp": "off",
        "eslint/sort-imports": "off",
        "import/no-namespace": "off"
      }
    }
  ]
}
