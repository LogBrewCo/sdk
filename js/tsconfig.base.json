{
  "compilerOptions": {
    "allowJs": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "checkJs": true,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "libReplacement": false,
    "module": "nodenext",
    "noEmit": true,
    "noErrorTruncation": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@logbrew/amqplib": ["./logbrew-amqplib/index.d.ts"],
      "@logbrew/angular": ["./logbrew-angular/index.d.ts"],
      "@logbrew/aws-sqs": ["./logbrew-aws-sqs/index.d.ts"],
      "@logbrew/browser": ["./logbrew-browser/index.d.ts"],
      "@logbrew/bullmq": ["./logbrew-bullmq/index.d.ts"],
      "@logbrew/express": ["./logbrew-express/index.d.ts"],
      "@logbrew/fastify": ["./logbrew-fastify/index.d.ts"],
      "@logbrew/nestjs": ["./logbrew-nestjs/index.d.ts"],
      "@logbrew/node": ["./logbrew-node/index.d.ts"],
      "@logbrew/sdk": ["./logbrew-js/index.d.ts"],
      "@logbrew/svelte": ["./logbrew-svelte/index.d.ts"],
      "@logbrew/vue": ["./logbrew-vue/index.d.ts"]
    },
    "skipLibCheck": false,
    "strict": true,
    "target": "es2022",
    "types": ["node"],
    "verbatimModuleSyntax": true
  }
}
