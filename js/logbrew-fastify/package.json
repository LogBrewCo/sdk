{
  "name": "@logbrew/fastify",
  "version": "0.1.5",
  "description": "Fastify plugin helpers for the public LogBrew JavaScript SDK.",
  "type": "module",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      },
      "default": "./index.js"
    }
  },
  "files": [
    "index.cjs",
    "index.js",
    "index.d.ts",
    "index.d.cts",
    "README.md",
    "examples"
  ],
  "keywords": [
    "logbrew",
    "fastify",
    "node",
    "plugin",
    "observability",
    "logs",
    "traces",
    "events"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LogBrewCo/sdk.git"
  },
  "peerDependencies": {
    "@logbrew/node": "^0.1.10",
    "@logbrew/sdk": "^0.1.6",
    "fastify": ">=4"
  },
  "dependencies": {
    "fastify-plugin": "^5.1.0"
  },
  "scripts": {
    "test": "bun ../../scripts/check_js_package_sources.mjs"
  }
}
