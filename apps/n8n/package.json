{
  "name": "n8n-nodes-logbrew",
  "version": "0.1.2",
  "description": "LogBrew nodes for n8n. Start workflows on new issues and fired alerts, send logs, and resolve issues.",
  "license": "MIT",
  "homepage": "https://logbrew.co",
  "keywords": [
    "n8n-community-node-package",
    "logbrew",
    "error tracking",
    "logging",
    "monitoring"
  ],
  "author": {
    "name": "LogBrew",
    "email": "support@logbrew.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LogBrewCo/sdk.git",
    "directory": "apps/n8n"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && mkdir -p dist/icons && cp icons/*.svg dist/icons/ && cp nodes/LogBrew/LogBrew.node.json dist/nodes/LogBrew/ && cp nodes/LogBrewTrigger/LogBrewTrigger.node.json dist/nodes/LogBrewTrigger/",
    "lint": "n8n-node lint",
    "test": "bun test"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/LogBrewApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/LogBrew/LogBrew.node.js",
      "dist/nodes/LogBrewTrigger/LogBrewTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "1.3.0",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.10",
    "eslint": "10.15.0",
    "n8n-workflow": "3.3.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
