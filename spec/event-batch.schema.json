{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/logbrew/sdk/event-batch.schema.json",
  "title": "LogBrew Event Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["sdk", "events"],
  "properties": {
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "language", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "null"]
      }
    },
    "contextString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "contextId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "telemetryNamedVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/contextString" },
        "version": { "$ref": "#/$defs/contextString" }
      }
    },
    "telemetryResource": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "service": { "$ref": "#/$defs/telemetryNamedVersion" },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "environment": { "$ref": "#/$defs/contextString" },
            "release": { "$ref": "#/$defs/contextString" }
          }
        },
        "runtime": { "$ref": "#/$defs/telemetryNamedVersion" },
        "framework": { "$ref": "#/$defs/telemetryNamedVersion" },
        "operatingSystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "$ref": "#/$defs/contextString" },
            "version": { "$ref": "#/$defs/contextString" },
            "build": { "$ref": "#/$defs/contextString" }
          }
        },
        "device": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "family": { "$ref": "#/$defs/contextString" },
            "model": { "$ref": "#/$defs/contextString" },
            "architecture": { "$ref": "#/$defs/contextString" }
          }
        },
        "application": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "name": { "$ref": "#/$defs/contextString" },
            "version": { "$ref": "#/$defs/contextString" },
            "build": { "$ref": "#/$defs/contextString" }
          }
        }
      }
    },
    "telemetryTraceContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId"],
      "properties": {
        "traceId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$",
          "not": { "const": "00000000000000000000000000000000" }
        },
        "spanId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{16}$",
          "not": { "const": "0000000000000000" }
        },
        "parentSpanId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{16}$",
          "not": { "const": "0000000000000000" }
        },
        "sampled": { "type": "boolean" }
      }
    },
    "telemetrySessionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/contextId" },
        "previousId": { "$ref": "#/$defs/contextId" }
      }
    },
    "telemetrySubjectContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/contextId" },
        "kind": { "type": "string", "enum": ["anonymous", "user"] }
      }
    },
    "telemetryTags": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
      }
    },
    "telemetryContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion"],
      "minProperties": 2,
      "properties": {
        "schemaVersion": { "const": 1 },
        "resource": { "$ref": "#/$defs/telemetryResource" },
        "trace": { "$ref": "#/$defs/telemetryTraceContext" },
        "session": { "$ref": "#/$defs/telemetrySessionContext" },
        "subject": { "$ref": "#/$defs/telemetrySubjectContext" },
        "tags": { "$ref": "#/$defs/telemetryTags" }
      }
    },
    "spanEventSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "spanLinkSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId", "spanId"],
      "properties": {
        "traceId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$",
          "not": { "const": "00000000000000000000000000000000" }
        },
        "spanId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{16}$",
          "not": { "const": "0000000000000000" }
        },
        "sampled": { "type": "boolean" },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "issueStackFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "line", "column"],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^?#\\u0000-\\u001f\\u007f]+$"
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "column": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "function": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
        },
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?=.*\\S)[^?#\\u0000-\\u001f\\u007f]+$"
        },
        "inApp": {
          "type": "boolean"
        },
        "debugId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      }
    },
    "issueExceptionMechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "handled"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$"
        },
        "handled": { "type": "boolean" }
      }
    },
    "issueException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?=.*\\S)[^?#\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "mechanism": { "$ref": "#/$defs/issueExceptionMechanism" }
      }
    },
    "issueBreadcrumbData": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" }
        ]
      }
    },
    "issueBreadcrumb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "category"],
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$"
        },
        "level": {
          "type": "string",
          "enum": ["debug", "info", "warning", "error", "critical"]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "data": { "$ref": "#/$defs/issueBreadcrumbData" }
      }
    },
    "eventBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "timestamp", "id", "attributes"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["release", "environment", "issue", "log", "span", "action", "metric"]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "releaseEvent": {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "properties": {
            "type": { "const": "release" },
            "attributes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version"],
              "properties": {
                "version": { "type": "string", "minLength": 1 },
                "commit": { "type": "string", "minLength": 1 },
                "notes": { "type": "string" },
                "metadata": { "$ref": "#/$defs/metadata" },
                "context": { "$ref": "#/$defs/telemetryContext" }
              }
            }
          }
        }
      ]
    },
    "environmentEvent": {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "properties": {
            "type": { "const": "environment" },
            "attributes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "region": { "type": "string" },
                "metadata": { "$ref": "#/$defs/metadata" },
                "context": { "$ref": "#/$defs/telemetryContext" }
              }
            }
          }
        }
      ]
    },
    "issueEvent": {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "properties": {
            "type": { "const": "issue" },
            "attributes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "level"],
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "level": {
                  "type": "string",
                  "enum": ["info", "warning", "error", "critical"]
                },
                "message": { "type": "string" },
                "exception": { "$ref": "#/$defs/issueException" },
                "stackFrames": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": { "$ref": "#/$defs/issueStackFrame" }
                },
                "breadcrumbs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": { "$ref": "#/$defs/issueBreadcrumb" }
                },
                "breadcrumbsTruncated": { "type": "boolean" },
                "metadata": { "$ref": "#/$defs/metadata" },
                "context": { "$ref": "#/$defs/telemetryContext" }
              }
            }
          }
        }
      ]
    },
    "logEvent": {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "properties": {
            "type": { "const": "log" },
            "attributes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["message", "level"],
              "properties": {
                "message": { "type": "string", "minLength": 1 },
                "level": {
                  "type": "string",
                  "enum": ["debug", "info", "warning", "error"]
                },
                "logger": { "type": "string" },
                "metadata": { "$ref": "#/$defs/metadata" },
                "context": { "$ref": "#/$defs/telemetryContext" }
              }
            }
          }
        }
      ]
    },
    "spanEvent": {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "properties": {
            "type": { "const": "span" },
            "attributes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "traceId", "spanId", "status"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "traceId": { "type": "string", "minLength": 1 },
                "spanId": { "type": "string", "minLength": 1 },
                "parentSpanId": { "type": "string", "minLength": 1 },
                "status": {
                  "type": "string",
                  "enum": ["ok", "error"]
                },
                "durationMs": { "type": "number", "minimum": 0 },
                "events": {
                  "type": "array",
                  "maxItems": 8,
                  "items": { "$ref": "#/$defs/spanEventSummary" }
                },
                "links": {
                  "type": "array",
                  "maxItems": 8,
                  "items": { "$ref": "#/$defs/spanLinkSummary" }
                },
                "metadata": { "$ref": "#/$defs/metadata" },
                "context": { "$ref": "#/$defs/telemetryContext" }
              }
            }
          }
        }
      ]
    },
    "actionEvent": {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "properties": {
            "type": { "const": "action" },
            "attributes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "status"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "status": {
                  "type": "string",
                  "enum": ["queued", "running", "success", "failure"]
                },
                "metadata": { "$ref": "#/$defs/metadata" },
                "context": { "$ref": "#/$defs/telemetryContext" }
              }
            }
          }
        }
      ]
    },
    "metricEvent": {
      "allOf": [
        { "$ref": "#/$defs/eventBase" },
        {
          "properties": {
            "type": { "const": "metric" },
            "attributes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind", "value", "unit", "temporality"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "kind": {
                  "type": "string",
                  "enum": ["counter", "gauge", "histogram"]
                },
                "value": { "type": "number" },
                "unit": { "type": "string", "minLength": 1 },
                "temporality": {
                  "type": "string",
                  "enum": ["delta", "cumulative", "instant"]
                },
                "metadata": { "$ref": "#/$defs/metadata" },
                "context": { "$ref": "#/$defs/telemetryContext" }
              },
              "allOf": [
                {
                  "if": {
                    "properties": { "kind": { "const": "counter" } }
                  },
                  "then": {
                    "properties": {
                      "value": { "minimum": 0 },
                      "temporality": { "enum": ["delta", "cumulative"] }
                    }
                  }
                },
                {
                  "if": {
                    "properties": { "kind": { "const": "histogram" } }
                  },
                  "then": {
                    "properties": {
                      "value": { "minimum": 0 },
                      "temporality": { "enum": ["delta", "cumulative"] }
                    }
                  }
                },
                {
                  "if": {
                    "properties": { "kind": { "const": "gauge" } }
                  },
                  "then": {
                    "properties": {
                      "temporality": { "const": "instant" }
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "event": {
      "oneOf": [
        { "$ref": "#/$defs/releaseEvent" },
        { "$ref": "#/$defs/environmentEvent" },
        { "$ref": "#/$defs/issueEvent" },
        { "$ref": "#/$defs/logEvent" },
        { "$ref": "#/$defs/spanEvent" },
        { "$ref": "#/$defs/actionEvent" },
        { "$ref": "#/$defs/metricEvent" }
      ]
    }
  }
}
